{
  "AppSettings": {
    "DefaultSourceLanguage": "en",
    "DefaultTargetLanguage": "tr",
    "ProfilesDirectory": "Profiles",
    "PythonExePath": "",
    "EnableOcrCache": true,
    "OcrIntervalMilliseconds": 1000,
    "MinimumConfidenceThreshold": 0.5
  },
  "OcrEngine": {
    "Profile": "Balanced",
    "ExecutionMode": "SingleProvider",
    "PreferredProvider": "PaddleOCR",
    "EnableOcrProviderFallback": false,
    "AutoStartOcrServer": true,
    "IgnoreOcrConfidenceThresholdForDebug": false,
    "EnableParallelOcr": false,
    "EnableSlowOcrProviders": false,
    "OcrTimeoutMs": 4000,
    "SubprocessOcrTimeoutMs": 15000,
    "CaptureIntervalMs": 100,
    "MaxOcrFrameBufferSize": 10,
    "AggressiveDuplicateFiltering": true,
    "HudFiltering": true,
    "PreprocessingPreset": "FastSubtitle"
  },
  "Translation": {
    "EnableTranslation": true,
    "Profile": "Balanced",
    "ProviderChainMode": "LocalOnly",
    "ProviderType": "OpusMT",
    "EnableTranslationProviderFallback": true,
    "AllowFallbackDuringProviderTest": false,
    "EnableCloudProviders": false,
    "FastTranslationTimeoutMs": 1200,
    "BalancedTranslationTimeoutMs": 1800,
    "AccurateTranslationTimeoutMs": 3500,
    "SourceLanguage": "en",
    "TargetLanguage": "tr",
    "MachineTranslationBaseUrl": "http://127.0.0.1:8770",
    "MachineTranslationTimeoutMs": 4500,
    "MachineTranslationModel": "Helsinki-NLP/opus-mt-tc-big-en-tr",
    "AutoStartMachineTranslationServer": true,
    "AutoStartOpusServer": true,
    "StartOpusOnlyWhenSelectedOrFallback": true,
    "OllamaBaseUrl": "http://localhost:11434",
    "OllamaModel": "qwen3:4b",
    "LmStudioBaseUrl": "http://127.0.0.1:1234",
    "LmStudioModel": "",
    "LmStudioTimeoutMs": 10000,
    "TranslationTimeoutMs": 120000,
    "UseTranslationCache": true,
    "DropStaleTranslations": false,
    "ShowOcrFallbackWhenTranslationFails": true,
    "ShowSourceWhileTranslating": false,
    "KeepTranslatedTextWhileSameSourceDetected": true,
    "MinTranslatedDisplayMs": 1200,
    "ClearOverlayAfterNoSubtitleMs": 1400,
    "MaxTranslationQueueSize": 5,
    "SubtitleDedupSimilarityThreshold": 0.86,
    "MinSubtitleDisplayMs": 1200,
    "MaxSubtitleAgeMs": 5000,
    "DropExpiredUntranslatedSubtitles": true,
    "PrioritizeCurrentSubtitle": true,
    "DisplayMode": "OcrThenTranslate",
    "TurkishOnlyMode": true,
    "KeepPreviousTurkishWhileTranslating": true,
    "MinTurkishDisplayMs": 1700,
    "MaxTurkishDisplayMs": 5000,
    "ShowPendingIndicator": false,
    "ShowMaskWhileTranslationPending": true,
    "EnableReadableSubtitleTiming": true,
    "MsPerCharacter": 45,
    "ExtraLineMs": 350,
    "MaxCapturedQueueSize": 12,
    "CaptureQueueMaxAgeMs": 8000,
    "DuplicateSimilarityThreshold": 0.86,
    "UpdateLastSeenForDuplicates": true,
    "PreserveQueueOrder": true,
    "OrderedTranslationQueueMaxSize": 8,
    "MaxConcurrentTranslations": 1,
    "DropExpiredBeforeTranslation": true,
    "MaxAgeBeforeTranslationMs": 6000,
    "PreferMemoryAndCacheInstant": true,
    "MaxPlaybackQueueSize": 10,
    "EnableStaleTranslationGraceWindow": true,
    "StaleTranslationGraceMs": 2500,
    "MinTurkishDisplayUnderPressureMs": 900,
    "ReplaceSameSourceIfBetter": true,
    "DoNotSkipReadyTranslations": true,
    "SubtitleStabilizationMs": 250,
    "MaxSubtitleMergeWindowMs": 6000,
    "MergeNearbySubtitleLines": true
  },
  "SubtitleFormatter": {
    "EnableSubtitleFormatter": true,
    "MaxSubtitleLines": 2,
    "MaxCharactersPerLine": 42,
    "ShowSpeakerName": true,
    "RemoveHudNoise": true,
    "HudNoiseWords": [ "Switch", "Menu", "Map", "Inventory" ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/ps-game-translator-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}
