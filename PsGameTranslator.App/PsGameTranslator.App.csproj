<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041.0 exposes the Windows.Media.Ocr WinRT projection for WindowsOcrProvider. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- User-facing branding. The assembly/namespace names stay PsGameTranslator.*
         (renaming them buys nothing and would touch every file); everything a user
         actually sees — window title, EXE properties, installer — says LiveSub. -->
    <AssemblyName>LiveSub</AssemblyName>
    <Product>LiveSub</Product>
    <AssemblyTitle>LiveSub</AssemblyTitle>
    <Description>Real-time game subtitle capture, OCR and translation overlay.</Description>
    <Version>0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo_icon.png" />
    <Resource Include="Assets\logo_icon_transparent.png" />
    <Resource Include="Assets\app.ico" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="config\dictionaries\global\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="config\dictionaries\genre\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="config\dictionaries\game\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\tools\ocr\paddle_ocr.py" Link="tools\ocr\paddle_ocr.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\tools\ocr\ocr_server.py" Link="tools\ocr\ocr_server.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The local translation server. Without this the app has no local OPUS-MT
         backend at all and every request to 127.0.0.1:8770 is refused — it was
         missing from the packaged build while the dev-only training script below
         was being shipped instead. -->
    <Content Include="..\tools\translation\translation_server.py" Link="tools\translation\translation_server.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Ship the requirements files: the sidecar servers run on the user's own
         Python, so this is the only way an installed user can know what to
         pip install. A missing python-multipart silently killed the OCR server. -->
    <Content Include="..\tools\ocr\requirements.txt" Link="tools\ocr\requirements.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\tools\translation\requirements.txt" Link="tools\translation\requirements.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Training is a developer-mode feature, which is Debug-only — no reason to
         ship the training script to end users. -->
    <Content Include="..\tools\translation\train_opus_mt.py" Link="tools\translation\train_opus_mt.py" Condition="'$(Configuration)' == 'Debug'">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\artifacts\game-recognition-igdb-steam-v2-20260715\game_recognition_efficientnet_b0.onnx" Link="models\game-recognition\game_recognition_efficientnet_b0.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\artifacts\game-recognition-igdb-steam-v2-20260715\labels.json" Link="models\game-recognition\labels.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Wpf.Ui" Version="3.4.2.7" />
  </ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\PsGameTranslator.Core\PsGameTranslator.Core.csproj" />
		<ProjectReference Include="..\PsGameTranslator.Capture\PsGameTranslator.Capture.csproj" />
		<ProjectReference Include="..\PsGameTranslator.Ocr\PsGameTranslator.Ocr.csproj" />
		<ProjectReference Include="..\PsGameTranslator.Overlay\PsGameTranslator.Overlay.csproj" />
		<ProjectReference Include="..\PsGameTranslator.Infrastructure\PsGameTranslator.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Views\User\" />
	</ItemGroup>

</Project>
