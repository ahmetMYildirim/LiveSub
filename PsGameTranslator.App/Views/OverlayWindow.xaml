<Window x:Class="PsGameTranslator.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual">

    <Grid>
        <Border x:Name="OuterBorder"
                Margin="8"
                BorderThickness="0"
                ClipToBounds="True"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="ConfigHeader"
                        Grid.Row="0"
                        Background="#CC0055CC"
                        CornerRadius="8,8,0,0"
                        Padding="8,5"
                        Cursor="SizeAll"
                        Visibility="Collapsed"
                        MouseLeftButtonDown="ConfigHeader_MouseLeftButtonDown">
                    <TextBlock Text="CONFIGURE - drag to move - drag corner to resize"
                               Foreground="White"
                               FontSize="11"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               IsHitTestVisible="False" />
                </Border>

                <StackPanel Grid.Row="1" x:Name="TextContainer">
                    <!-- Speaker name: its own line, centered above the subtitle, in
                         the same warm off-white the games use for name plates (see
                         the reference screenshot). Rendered separately from the
                         translated line so it is never merged into the sentence and
                         can carry its own colour/size. -->
                    <TextBlock x:Name="SpeakerTextBlock"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontWeight="Bold"
                               Foreground="#FFEDE6D6"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               Margin="0,0,0,2">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Color="Black" Opacity="0.95" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <Grid x:Name="SubtitleGrid">
                        <TextBlock x:Name="OutlineTopLeftTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="Black"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="OutlineTopLeftTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="OutlineTopRightTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="Black"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="OutlineTopRightTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="OutlineBottomLeftTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="Black"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="OutlineBottomLeftTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="OutlineBottomRightTextBlock"
                                   TextWrapping="Wrap"
                                   Foreground="Black"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="OutlineBottomRightTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>

                        <TextBlock x:Name="OcrTextBlock"
                                   TextWrapping="Wrap"
                                   TextTrimming="None"
                                   Foreground="White"
                                   IsHitTestVisible="False" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Thumb x:Name="ResizeThumb"
               Width="22"
               Height="22"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Visibility="Collapsed"
               Margin="0,0,6,6"
               DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Canvas Width="14" Height="14">
                        <Line X1="2" Y1="14" X2="14" Y2="2"
                              Stroke="DodgerBlue" StrokeThickness="2" Opacity="0.9" />
                        <Line X1="7" Y1="14" X2="14" Y2="7"
                              Stroke="DodgerBlue" StrokeThickness="2" Opacity="0.9" />
                        <Line X1="12" Y1="14" X2="14" Y2="12"
                              Stroke="DodgerBlue" StrokeThickness="2" Opacity="0.9" />
                    </Canvas>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
