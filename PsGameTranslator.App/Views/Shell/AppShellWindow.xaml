<Window x:Class="PsGameTranslator.App.Views.Shell.AppShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:user="clr-namespace:PsGameTranslator.App.ViewModels.User"
        xmlns:vm="clr-namespace:PsGameTranslator.App.ViewModels"
        xmlns:conv="clr-namespace:PsGameTranslator.App.Converters"
        mc:Ignorable="d"
        Title="LiveSub"
        Width="1560"
        Height="980"
        MinWidth="1180"
        MinHeight="760"
        Background="{DynamicResource AppBgBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Control+Shift" Command="{Binding ToggleDeveloperModeCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />

        <DataTemplate DataType="{x:Type user:HomeViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="205" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" MinHeight="100" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.ColumnSpan="2" Style="{DynamicResource CardStyle}" Padding="0">
                        <Grid>
                            <!-- Cover photo: the Steam header art for the recognised game,
                                 fetched by GameCoverService. It is a wide (460x215) horizontal
                                 banner, so UniformToFill spreads it cleanly across the hero.
                                 Renders nothing (transparent) until a game is matched, so the
                                 plain gradient below shows through as the fallback look. -->
                            <Border CornerRadius="8" ClipToBounds="True">
                                <Image Source="{Binding Capture.CoverImageSource}" Stretch="UniformToFill" />
                            </Border>
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#CC1A2A44" Offset="0" />
                                        <GradientStop Color="#DD0A111D" Offset="0.58" />
                                        <GradientStop Color="#CC17233A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Path Fill="#243A60" Opacity="0.4" Stretch="Fill" Data="M0,160 L160,65 L285,138 L430,42 L620,170 L820,80 L980,170 L980,205 L0,205 Z" />
                            <StackPanel Margin="32,0,480,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GameTitle}" Foreground="White" FontSize="31" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding WindowInfo}" Foreground="#B7C2D8" FontSize="16" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                    <Button Content="{DynamicResource Start}" Command="{Binding StartCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                                    <Button Content="{DynamicResource Stop}" Command="{Binding StopCommand}" Style="{DynamicResource DangerButtonStyle}" Margin="10,0,0,0" />
                                    <Button Content="{DynamicResource SelectGame}" Command="{Binding DataContext.SelectGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource SecondaryButtonStyle}" Margin="10,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{DynamicResource CardStyle}" Margin="0,22,22,22" Background="#0A0F18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource LivePreview}" Foreground="#B7C2D8" FontSize="13" FontWeight="SemiBold" />
                            <Border Grid.Row="1" Background="Black" CornerRadius="8" Margin="0,12,0,0" Padding="18">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Monitoring.FormatterRawOcrText}" Foreground="White" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Translation.LastTranslatedText}" Foreground="{DynamicResource AccentBrush}" FontSize="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardStyle}" MinHeight="120">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#332FB6C4">
                                        <TextBlock Text="&#128247;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource OcrStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding IsOcrOk, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="&#10003;" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding OcrStatus}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" MaxHeight="28" TextTrimming="CharacterEllipsis" ToolTip="{Binding OcrStatus}" />
                                <TextBlock Text="{Binding OcrEngine}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{DynamicResource CardStyle}" MinHeight="120">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#332F6BFF">
                                        <TextBlock Text="&#128260;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource TranslationStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding IsTranslationOk, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="&#10003;" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding TranslationStatus}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" MaxHeight="28" TextTrimming="CharacterEllipsis" ToolTip="{Binding TranslationStatusDetail}" />
                                <TextBlock Text="{Binding TranslationEngine}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TranslationStatusDetail}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{DynamicResource CardStyle}" MinHeight="120">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="9" Background="#337C5CFF">
                                        <TextBlock Text="&#127916;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource OverlayStatus}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0" />
                                    <Border Grid.Column="2" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="{Binding IsOverlayOk, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="&#10003;" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding OverlayStatus}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" MaxHeight="28" TextTrimming="CharacterEllipsis" ToolTip="{Binding OverlayStatus}" />
                                <TextBlock Text="{Binding OverlayMode}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Latency}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{Binding AvgLatency}" Foreground="{DynamicResource WarningBrush}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="FPS" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{Binding Fps}" Foreground="{DynamicResource SuccessBrush}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="CPU" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{Binding SystemResources.CpuUsageText}" Foreground="{DynamicResource AccentBrush2}" FontSize="18" FontWeight="Bold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{DynamicResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="RAM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                <TextBlock Text="{Binding SystemResources.RamUsageText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="{DynamicResource QuickSettings}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16" />

                            <TextBlock Text="{DynamicResource TranslationEngine}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <ComboBox SelectedIndex="{Binding Translation.CeviriMotoruIndex}" Margin="0,6,0,12">
                                <ComboBoxItem Content="{DynamicResource EngineOpusMt}" />
                                <ComboBoxItem Content="{DynamicResource EngineOllama}" />
                                <ComboBoxItem Content="{DynamicResource EngineLmStudio}" />
                                <ComboBoxItem Content="Google Translate" />
                                <ComboBoxItem Content="DeepL" />
                                <ComboBoxItem Content="Gemini" />
                                <ComboBoxItem Content="Groq" />
                            </ComboBox>

                            <TextBlock Text="{DynamicResource OcrEngine}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <ComboBox SelectedIndex="{Binding Ocr.OcrProviderTypeIndex}" Margin="0,6,0,12">
                                <ComboBoxItem Content="PaddleOCR" />
                                <ComboBoxItem Content="WindowsOCR" />
                                <ComboBoxItem Content="RapidOCR" />
                                <ComboBoxItem Content="EasyOCR" />
                                <ComboBoxItem Content="OneOCR" />
                                <ComboBoxItem Content="MockOCR" />
                                <ComboBoxItem Content="Multi-OCR" />
                            </ComboBox>

                            <TextBlock Text="{DynamicResource OcrMode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <ComboBox SelectedIndex="{Binding Ocr.OcrProfileIndex}" Margin="0,6,0,12">
                                <ComboBoxItem Content="{DynamicResource OcrModeFast}" />
                                <ComboBoxItem Content="{DynamicResource OcrModeBalanced}" />
                                <ComboBoxItem Content="{DynamicResource OcrModeHybrid}" />
                            </ComboBox>

                            <TextBlock Text="{DynamicResource SourceLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <ComboBox IsEditable="True" Text="{Binding Translation.SourceLanguage, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12">
                                <ComboBoxItem Content="en" />
                                <ComboBoxItem Content="ja" />
                                <ComboBoxItem Content="ko" />
                                <ComboBoxItem Content="zh" />
                            </ComboBox>

                            <TextBlock Text="{DynamicResource TargetLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <ComboBox IsEditable="True" Text="{Binding Translation.TargetLanguage, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12">
                                <ComboBoxItem Content="tr" />
                                <ComboBoxItem Content="en" />
                            </ComboBox>

                            <TextBlock Text="{DynamicResource TranslationMode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <ComboBox SelectedIndex="{Binding TranslationModeIndex}" Margin="0,6,0,18">
                                <ComboBoxItem Content="{DynamicResource MachineTranslation}" />
                                <ComboBoxItem Content="{DynamicResource OcrOnlyMode}" />
                            </ComboBox>

                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource NavGlossary}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding Translation.EnableGlossaryCorrections}" />
                            </Grid>

                            <Button Content="{Binding StartStopButtonText}" Command="{Binding ToggleMonitoringCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="48" />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{DynamicResource SubtitleRegion}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                            <Border Grid.Row="1" Background="#070A11" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,14,0,0">
                                <Grid>
                                    <Image Source="{Binding Monitoring.CropPreview}" Stretch="Uniform" />
                                    <Rectangle Margin="42" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" RadiusX="4" RadiusY="4" />
                                    <TextBlock Text="{Binding Monitoring.TargetWindowText}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />

                                    <!-- Overlaid rather than a sibling row so toggling developer mode
                                         never reflows/shrinks the preview above. -->
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,0,10"
                                                Visibility="{Binding DataContext.IsDeveloperMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="{DynamicResource RunOneFrame}" Command="{Binding Monitoring.RunSingleTickCommand}" Style="{DynamicResource SecondaryButtonStyle}" Padding="10,4" />
                                        <Button Content="{DynamicResource OcrTest}" Command="{Binding Monitoring.RunOcrOnCurrentPreviewCommand}" Style="{DynamicResource SecondaryButtonStyle}" Padding="10,4" Margin="8,0,0,0" />
                                        <Button Content="{DynamicResource OverlayTest}" Command="{Binding TestOverlayCommand}" Style="{DynamicResource PrimaryButtonStyle}" Padding="10,4" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LiveStats}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource OcrStarted}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.OcrStartedCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush2}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource OcrCompleted}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.OcrCompletedCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource SkippedNoChange}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.OcrSkippedNoChangeCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource ForcedOcr}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.OcrForcedCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource TranslationQueued}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.TranslationPendingCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource CaptureFpsLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.CaptureFps, StringFormat={}{0:F1}}" Foreground="{DynamicResource SuccessBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>

                                <!-- Per-stage timing so a low Capture FPS above can be traced to
                                     whichever stage is actually slow (capture vs crop vs frame-diff). -->
                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource CaptureDuration}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.CaptureDurationMs, StringFormat={}{0} ms}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource CropDuration}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.CropDurationMs, StringFormat={}{0} ms}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource DifferenceDuration}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.DifferenceDurationMs, StringFormat={}{0} ms}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource OcrDurationLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.OcrDurationMs, StringFormat={}{0} ms}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Row="5" Grid.Column="0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{DynamicResource TranslationDurationLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Monitoring.TranslationDurationMs, StringFormat={}{0} ms}" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="SemiBold" Margin="16,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="6" Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource LatestTranslations}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Translation.RecentTranslations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding SourceText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{Binding TranslatedText}" Foreground="{DynamicResource AccentBrush}" FontSize="15" TextWrapping="Wrap" Margin="18,0,0,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="18,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type user:CapturePageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" MinHeight="420" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                                <TextBlock Text="{DynamicResource CapturableWindows}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" />
                                <Button Content="{DynamicResource Refresh}" Command="{Binding Capture.RefreshCommand}" Style="{DynamicResource PrimaryButtonStyle}" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Capture.Windows}" SelectedItem="{Binding Capture.SelectedWindow}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource ColTitle}" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="{DynamicResource ColProcess}" Binding="{Binding ProcessName}" Width="150" />
                                    <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                                    <DataGridTextColumn Header="{DynamicResource ColSize}" Binding="{Binding Width}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource LivePreviewTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" />
                            <Border Height="260" Background="#070A11" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,16,0,16">
                                <Image Source="{Binding Capture.PreviewImageSource}" Stretch="Uniform" />
                            </Border>
                            <TextBlock Text="{Binding Capture.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <Button Content="{DynamicResource TakeScreenshot}" Command="{Binding Capture.CaptureCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                            <Button Content="{DynamicResource DetectGameFromScreen}" Command="{Binding Capture.IdentifyFromScreenshotCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,10,0,0"
                                    ToolTip="PS5 Remote Play veya YouTube gibi pencere başlığından anlaşılamayan kaynaklar için — görüntüyü yerel bir görsel modele (Ollama) gönderip oyunu tanır." />

                            <Border Margin="0,14,0,0" Padding="14" Background="{DynamicResource PanelSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="8"
                                    Visibility="{Binding Capture.PendingGameCandidate, Converter={StaticResource NullToCollapsedConverter}}">
                                <StackPanel>
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap">
                                        <Run Text="{DynamicResource ScreenshotLooksLike1}" /><Run Text="{Binding Capture.PendingGameCandidate.DisplayName, Mode=OneWay}" FontWeight="Bold" /><Run Text="{DynamicResource ScreenshotLooksLike2}" />
                                    </TextBlock>
                                    <TextBlock Text="{DynamicResource VisionModelHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,10" TextWrapping="Wrap" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="{DynamicResource YesLoad}" Command="{Binding Capture.ConfirmPendingGameCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                                        <Button Grid.Column="2" Content="{DynamicResource No}" Command="{Binding Capture.RejectPendingGameCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Padding="14" Style="{DynamicResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource SelectGameManually}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource VisionModelManualHint}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,10" />
                                    <ComboBox ItemsSource="{Binding Capture.ManualGameOptions}" SelectedItem="{Binding Capture.SelectedManualGame}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Content="{DynamicResource LoadThisGlossary}" Command="{Binding Capture.LoadManualGameCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Altyazi bolgesi secimi: oyun penceresi secilince otomatik alinan
                     ekran goruntusu uzerine dikdortgen cizerek OCR'in okuyacagi alani
                     belirle. Kucuk bir bolge = daha hizli OCR (bkz. CropSizeWarningText). -->
                <Border Grid.Row="2" Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <!-- Fixed (not Auto/star) so Viewbox Stretch=Uniform always scales
                                     the full screenshot to fit inside this exact box — an Auto row
                                     nested this deep gets measured with infinite height, so it let
                                     the image request more room than the card actually had and the
                                     bottom got clipped by the page boundary instead of scaled down. -->
                                <RowDefinition Height="320" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" LastChildFill="False">
                                <TextBlock Text="{DynamicResource SubtitleRegionSelection}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" DockPanel.Dock="Left" />
                                <Button Content="{DynamicResource SelectFullscreen}" Command="{Binding Region.SelectFullscreenCommand}" Style="{DynamicResource PrimaryButtonStyle}" DockPanel.Dock="Right" />
                                <Button Content="{DynamicResource LoadScreenshot}" Command="{Binding Region.LoadScreenshotCommand}" Style="{DynamicResource SecondaryButtonStyle}" DockPanel.Dock="Right" Margin="0,0,10,0" />
                            </DockPanel>

                            <Border Grid.Row="2" Background="#070A11" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Grid>
                                    <TextBlock Text="{DynamicResource NoScreenshotHint}"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                                               Visibility="{Binding Region.IsScreenshotLoaded, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                                    <Viewbox x:Name="SelectionViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Visibility="{Binding Region.IsScreenshotLoaded, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid Width="{Binding Region.ScreenshotPixelWidth}" Height="{Binding Region.ScreenshotPixelHeight}">
                                            <Image x:Name="ScreenshotImage" Source="{Binding Region.ScreenshotSource}"
                                                   Width="{Binding Region.ScreenshotPixelWidth}" Height="{Binding Region.ScreenshotPixelHeight}" Stretch="Fill" />
                                            <Canvas x:Name="SelectionOverlay"
                                                    Width="{Binding Region.ScreenshotPixelWidth}" Height="{Binding Region.ScreenshotPixelHeight}"
                                                    Background="Transparent" Cursor="Cross"
                                                    MouseDown="SelectionOverlay_MouseDown"
                                                    MouseMove="SelectionOverlay_MouseMove"
                                                    MouseUp="SelectionOverlay_MouseUp">
                                                <Rectangle x:Name="SelectionRect" IsHitTestVisible="False" Visibility="Collapsed"
                                                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeDashArray="6 2" Fill="#227C5CFF" />
                                            </Canvas>
                                        </Grid>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="4" Text="{Binding Region.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </Grid>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource SelectedRegion}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                    <TextBlock Text="X" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Region.RegionX}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                    <TextBlock Text="Y" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Region.RegionY}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="{DynamicResource WidthLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Region.RegionWidth}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="{DynamicResource HeightLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding Region.RegionHeight}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>

                            <Button Content="{DynamicResource SaveRegion}" Command="{Binding Region.SaveRegionCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,0,10" />
                            <Button Content="{DynamicResource CropSelectedRegion}" Command="{Binding Region.CropRegionCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,8" />

                            <TextBlock Text="{DynamicResource CroppedPreview}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8" />
                            <Border Height="90" Background="#070A11" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Image Source="{Binding Region.CroppedPreviewSource}" Stretch="Uniform" Margin="4" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource SecondaryOcrRegions}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" />
                            <Button Content="{DynamicResource AddRegion}" Command="{Binding Monitoring.AddSecondaryOcrRegionCommand}" Style="{DynamicResource PrimaryButtonStyle}" DockPanel.Dock="Right" />
                        </DockPanel>
                        <TextBlock Text="{DynamicResource SecondaryRegionsHint}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <CheckBox Content="İkincil OCR ile konuşmacı adı al" IsChecked="{Binding Monitoring.EnableSecondarySpeakerOcr}" Margin="0,0,0,8" />
                        <CheckBox Content="Konuşmacı adını altyazının üstünde göster" IsChecked="{Binding Monitoring.ShowSpeakerName}" Margin="0,0,0,14" />
                        <ItemsControl ItemsSource="{Binding Monitoring.SecondaryOcrRegions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource LabelField}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="X %" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding XPercent, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Y %" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding YPercent, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="{DynamicResource WidthPct}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding WidthPercent, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource HeightPct}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                                    <TextBox Text="{Binding HeightPercent, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="{DynamicResource Delete}"
                                                    Command="{Binding DataContext.Monitoring.RemoveSecondaryOcrRegionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{DynamicResource DangerButtonStyle}" VerticalAlignment="Center" />
                                        </Grid>
                                        <!-- Previously invisible/unreachable in the UI: UseForSpeakerName
                                             existed on the model and was persisted, but there was no control
                                             to see or set it, so users had no way to confirm which region
                                             (if any) actually fed the speaker name. GroupName gives radio-
                                             button exclusivity across every region in this ItemsControl. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <CheckBox Content="Etkin" IsChecked="{Binding IsEnabled}" Margin="0,0,20,0" />
                                            <RadioButton Content="Konuşmacı adı için kullan" GroupName="SecondarySpeakerRegion" IsChecked="{Binding UseForSpeakerName}" />
                                        </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </DataTemplate>

        <DataTemplate DataType="{x:Type user:TranslationPageViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource TranslationEngine}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" />
                        <CheckBox Content="{DynamicResource EnableTranslation}" IsChecked="{Binding Translation.EnableTranslation}" Margin="0,18,0,10" />
                        <CheckBox Content="{DynamicResource UseCache}" IsChecked="{Binding Translation.UseTranslationCache}" Margin="0,0,0,10" />
                        <CheckBox Content="{DynamicResource ShowOcrOnFailure}" IsChecked="{Binding Translation.ShowOcrFallbackWhenTranslationFails}" Margin="0,0,0,18" />

                        <TextBlock Text="{DynamicResource ActiveEngine}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox SelectedIndex="{Binding Translation.CeviriMotoruIndex}" Margin="0,6,0,12">
                            <ComboBoxItem Content="{DynamicResource EngineOpusMt}" />
                            <ComboBoxItem Content="{DynamicResource EngineOllama}" />
                            <ComboBoxItem Content="{DynamicResource EngineLmStudio}" />
                            <ComboBoxItem Content="Google Translate" />
                            <ComboBoxItem Content="DeepL" />
                            <ComboBoxItem Content="Gemini" />
                            <ComboBoxItem Content="Groq" />
                        </ComboBox>

                        <TextBlock Text="{DynamicResource SourceLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Translation.SourceLanguage, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,12" />
                        <TextBlock Text="{DynamicResource TargetLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Translation.TargetLanguage, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,18" />

                        <TextBlock Text="{DynamicResource LocalModelLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding Translation.MachineTranslationModelOptions}"
                                  Text="{Binding Translation.MachineTranslationModel, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,6,0,12" />

                        <TextBlock Text="Ollama Model" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding Translation.OllamaModels}"
                                  Text="{Binding Translation.OllamaModel, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,6,0,12" />

                        <TextBlock Text="LM Studio Model" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <ComboBox IsEditable="True"
                                  ItemsSource="{Binding Translation.LmStudioModels}"
                                  Text="{Binding Translation.LmStudioModel, UpdateSourceTrigger=PropertyChanged}"
                                  Margin="0,6,0,12" />
                        <Button Content="{DynamicResource RefreshModels}" Command="{Binding Translation.RefreshModelListsCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,18" />

                        <TextBlock Text="{DynamicResource TypewriterWaitLabel}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Translation.MaxSubtitleMergeWindowMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6" />
                        <TextBlock Text="{DynamicResource TypewriterWaitHint}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="{DynamicResource DebounceLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding Translation.SubtitleStabilizationMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,6" />
                        <TextBlock Text="{DynamicResource DebounceHint}"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18" />

                        <Button Content="{DynamicResource ProviderTest}" Command="{Binding Translation.TestSelectedTranslationProviderCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                        <Button Content="{DynamicResource PipelineHealthCheck}" Command="{Binding Translation.RunPipelineHealthCheckCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,10,0,0" />
                        <Button Content="{DynamicResource LivePipelineTest}" Command="{Binding Translation.TestLivePipelineEndToEndCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource TranslationTestDiagnostics}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" />
                        <Grid Grid.Row="1" Margin="0,18,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding Translation.TestTranslationText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="2" Content="{DynamicResource Translate}" Command="{Binding Translation.TestTranslateCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding Translation.StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Translation.LastTranslatedText}" Foreground="{DynamicResource AccentBrush}" FontSize="22" TextWrapping="Wrap" Margin="0,18,0,12" />
                                <TextBlock Text="{Binding Translation.PipelineDiagnosticsText}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type user:SettingsPageViewModel}">
            <Grid Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource CardStyle}" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource NavSettings}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" />
                            <TextBlock Text="{DynamicResource SettingsSubtitle}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource AdvancedSettings}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsAdvancedMode}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <Button Content="{DynamicResource ImportSettings}" Command="{Binding ImportSettingsCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource ExportSettings}" Command="{Binding ExportSettingsCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                            <Setter Property="Padding" Value="14,8" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter ContentSource="Header" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource SecondaryButtonBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="{DynamicResource Theme}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,12,0,0">
                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Theme}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <RadioButton Grid.Column="0"
                                                         Content="{DynamicResource Dark}"
                                                         GroupName="Theme"
                                                         IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}"
                                                         Command="{Binding SelectDarkThemeCommand}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <RadioButton Grid.Column="2"
                                                         Content="{DynamicResource Light}"
                                                         GroupName="Theme"
                                                         IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}"
                                                         Command="{Binding SelectLightThemeCommand}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </Grid>
                                        <TextBlock Text="{DynamicResource ThemeRestartHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,10" />
                                        <Button Content="{DynamicResource RestartNow}" Command="{Binding RestartToApplyThemeCommand}" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource SettingsManagement}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />

                                        <TextBlock Text="{DynamicResource PresetProfile}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,4" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox Grid.Column="0" SelectedIndex="{Binding SelectedPresetIndex}">
                                                <ComboBoxItem Content="{DynamicResource PresetFast}" />
                                                <ComboBoxItem Content="{DynamicResource PresetBalanced}" />
                                                <ComboBoxItem Content="{DynamicResource PresetQuality}" />
                                            </ComboBox>
                                            <Button Grid.Column="2" Content="{DynamicResource ApplyPreset}" Command="{Binding ApplyPresetCommand}" Style="{DynamicResource SecondaryButtonStyle}" Padding="16,0" HorizontalAlignment="Stretch" />
                                        </Grid>
                                        <TextBlock Text="{DynamicResource PresetProfileHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                                        <TextBlock Text="{Binding OperationStatus}" Foreground="{DynamicResource AccentBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{DynamicResource CloudApiKeysTitle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,12,0,0">
                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource CloudApiKeysTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                        <TextBlock Text="{DynamicResource CloudApiKeysHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,10" />

                                        <TextBlock Text="{DynamicResource GoogleApiKeyLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBox Text="{Binding Translation.GoogleTranslateApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,4" />
                                        <TextBlock Text="{Binding Translation.GoogleTranslateModeText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8" />
                                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8" />

                                        <TextBlock Text="{DynamicResource DeepLApiKeyLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBox Text="{Binding Translation.DeepLApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8" />
                                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8" />

                                        <TextBlock Text="{DynamicResource GeminiApiKeyLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBox Text="{Binding Translation.GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8" />
                                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8" />

                                        <TextBlock Text="{DynamicResource GroqApiKeyLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBox Text="{Binding Translation.GroqApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource AdvancedTranslation}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,12" />
                                        <CheckBox Content="{DynamicResource UseTranslationCache}" IsChecked="{Binding Translation.UseTranslationCache}" Margin="0,0,0,8" />
                                        <CheckBox Content="{DynamicResource DiscardOldTranslations}" IsChecked="{Binding Translation.DropStaleTranslations}" Margin="0,0,0,8" />
                                        <CheckBox Content="{DynamicResource ShowOcrWhenFailed}" IsChecked="{Binding Translation.ShowOcrFallbackWhenTranslationFails}" Margin="0,0,0,8" />
                                        <CheckBox Content="{DynamicResource EnableFallbackChain}" IsChecked="{Binding Translation.EnableTranslationProviderFallback}" Margin="0,0,0,4" />
                                        <TextBlock Text="{DynamicResource FallbackChainHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource FallbackChainOrder}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" />
                                        <TextBlock Text="{DynamicResource FallbackChainOrderHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ListBox Grid.Column="0" Height="130"
                                                     ItemsSource="{Binding Translation.FallbackChainItems}"
                                                     SelectedIndex="{Binding Translation.SelectedFallbackChainIndex}" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Button Content="▲" Command="{Binding Translation.MoveFallbackItemUpCommand}" Style="{DynamicResource SecondaryButtonStyle}" Width="36" Padding="4" Margin="0,0,0,4" />
                                                <Button Content="▼" Command="{Binding Translation.MoveFallbackItemDownCommand}" Style="{DynamicResource SecondaryButtonStyle}" Width="36" Padding="4" />
                                            </StackPanel>
                                        </Grid>
                                        <Button Content="{DynamicResource ResetToDefault}" Command="{Binding Translation.ResetFallbackOrderCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{DynamicResource Performance}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,12,0,0">
                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Performance}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                        <TextBlock Text="{DynamicResource CaptureIntervalLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,4" />
                                        <TextBox Text="{Binding Monitoring.CaptureIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{DynamicResource MinOcrIntervalLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,4" />
                                        <TextBox Text="{Binding Monitoring.MinOcrIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{DynamicResource OcrRequestTimeout}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,4" />
                                        <TextBox Text="{Binding Ocr.OcrTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Text="{DynamicResource OcrTimeoutHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{DynamicResource OcrDevice}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,10,0,4" />
                                        <ComboBox SelectedIndex="{Binding Ocr.OcrDeviceIndex}">
                                            <ComboBoxItem Content="{DynamicResource DeviceAuto}" />
                                            <ComboBoxItem Content="CPU" />
                                            <ComboBoxItem Content="{DynamicResource DeviceGpu}" />
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource GpuHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <CheckBox Content="{DynamicResource FastOcrMode}" IsChecked="{Binding Monitoring.EnableFastOcrMode}" Margin="0,10,0,0" />
                                        <CheckBox Content="{DynamicResource SaveDebugFrames}" IsChecked="{Binding Monitoring.SaveDebugFrames}" Margin="0,6,0,0" />
                                        <CheckBox Content="{DynamicResource PauseWhenInactive}" IsChecked="{Binding Monitoring.PauseWhenWindowNotActive}" Margin="0,6,0,0" />
                                        <TextBlock Text="{DynamicResource PauseHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource OcrPreprocessing}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" />
                                        <CheckBox Content="{DynamicResource EnablePreprocessing}" IsChecked="{Binding Monitoring.EnableOcrPreprocessing}" Margin="0,10,0,4" />
                                        <CheckBox Content="{DynamicResource ConvertGrayscaleShort}" IsChecked="{Binding Monitoring.ConvertToGrayscale}" Margin="0,0,0,4" />
                                        <CheckBox Content="{DynamicResource IncreaseContrast}" IsChecked="{Binding Monitoring.IncreaseContrast}" Margin="0,0,0,4" />
                                        <CheckBox Content="{DynamicResource SharpenImage}" IsChecked="{Binding Monitoring.SharpenImage}" Margin="0,0,0,6" />
                                        <TextBlock Text="{DynamicResource ThresholdMode}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4" />
                                        <ComboBox SelectedIndex="{Binding Monitoring.ThresholdModeIndex}">
                                            <ComboBoxItem Content="{DynamicResource ThresholdNone}" />
                                            <ComboBoxItem Content="Otsu" />
                                            <ComboBoxItem Content="{DynamicResource ThresholdFixed}" />
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource ThresholdHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource CharacterFilter}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" Margin="0,0,0,4" />
                                        <CheckBox Content="{DynamicResource LatinOnly}" IsChecked="{Binding Monitoring.EnableCharWhitelist}" Margin="0,10,0,4" />
                                        <TextBlock Text="{DynamicResource LatinOnlyHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{DynamicResource SystemRequirements}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" DockPanel.Dock="Left" />
                                            <Button Content="{DynamicResource Refresh}" Command="{Binding Ocr.RefreshSystemRequirementsCommand}" Style="{DynamicResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="12,4" Height="30" />
                                        </DockPanel>
                                        <TextBlock Text="{DynamicResource SystemRequirementsHint}"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10" />
                                        <ItemsControl ItemsSource="{Binding Ocr.SystemRequirements}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="&#x2714;" Foreground="{DynamicResource SuccessBrush}" FontSize="13" FontWeight="Bold"
                                                                   Visibility="{Binding IsMet, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Grid.Column="0" Text="&#x2716;" Foreground="{DynamicResource DangerBrush}" FontSize="13" FontWeight="Bold"
                                                                   Visibility="{Binding ShowUnmetRequired, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Grid.Column="0" Text="&#x2013;" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="Bold"
                                                                   Visibility="{Binding ShowUnmetOptional, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap">
                                                            <Run Text="{DynamicResource RequiredLabel}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding RequiredText, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </TextBlock>

                                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap">
                                                            <Run Text="{DynamicResource YouHaveLabel}" Foreground="{DynamicResource TextMutedBrush}" /><Run Text="{Binding ActualText, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Overlay">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,12,0,0">
                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock Text="{DynamicResource MonitorTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" DockPanel.Dock="Left" />
                                            <Button Content="{DynamicResource RefreshMonitors}" Command="{Binding Overlay.RefreshMonitorsCommand}" Style="{DynamicResource SecondaryButtonStyle}" DockPanel.Dock="Right" />
                                        </DockPanel>

                                        <TextBlock Text="{DynamicResource OverlayTargetMonitor}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,0" />
                                        <ComboBox SelectedIndex="{Binding Overlay.OverlayTargetMonitorModeIndex}" Margin="0,4,0,8">
                                            <ComboBoxItem Content="{DynamicResource PrimaryMonitor}" />
                                            <ComboBoxItem Content="{DynamicResource SameAsCapturedWindow}" />
                                            <ComboBoxItem Content="{DynamicResource ManualMonitor}" />
                                        </ComboBox>

                                        <TextBlock Text="{DynamicResource ManualMonitor}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <ComboBox ItemsSource="{Binding Overlay.AvailableMonitorDeviceNames}"
                                                  SelectedItem="{Binding Overlay.SelectedOverlayMonitorDeviceName}"
                                                  Margin="0,4,0,4" />
                                        <TextBlock Text="{Binding Overlay.ManualMonitorWarningText}"
                                                   Foreground="{DynamicResource WarningBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8" />

                                        <TextBlock Text="{DynamicResource ConnectedMonitors}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <ItemsControl ItemsSource="{Binding Overlay.ConnectedMonitorsDisplay}" Margin="0,4,0,8">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{DynamicResource PrimaryMonitor}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding Overlay.PrimaryMonitorText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,1,0,6" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource CapturedWindowMonitor}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding Overlay.CaptureWindowMonitorText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,1,0,6" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource OverlayCurrentLocation}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" />
                                        <TextBlock Text="{Binding Overlay.CurrentOverlayMonitorText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Margin="0,1,0,10" TextWrapping="Wrap" />

                                        <TextBlock Text="{DynamicResource OverlayPosition}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6" />

                                        <!-- Nine one-click anchors on the target monitor's working
                                             area. Dragging the overlay still works; this is the
                                             fast path for "put it bottom-centre and be done". -->
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,10">
                                            <UniformGrid Rows="3" Columns="3">
                                                <Button Content="◤" CommandParameter="TopLeft" ToolTip="{DynamicResource AnchorTopLeft}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                                <Button Content="▲" CommandParameter="TopCenter" ToolTip="{DynamicResource AnchorTopCenter}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                                <Button Content="◥" CommandParameter="TopRight" ToolTip="{DynamicResource AnchorTopRight}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                                <Button Content="◀" CommandParameter="MiddleLeft" ToolTip="{DynamicResource AnchorMiddleLeft}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                                <Button Content="■" CommandParameter="Center" ToolTip="{DynamicResource AnchorCenter}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                                <Button Content="▶" CommandParameter="MiddleRight" ToolTip="{DynamicResource AnchorMiddleRight}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                                <Button Content="◣" CommandParameter="BottomLeft" ToolTip="{DynamicResource AnchorBottomLeft}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                                <Button Content="▼" CommandParameter="BottomCenter" ToolTip="{DynamicResource AnchorBottomCenter}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                                <Button Content="◢" CommandParameter="BottomRight" ToolTip="{DynamicResource AnchorBottomRight}" Command="{Binding Overlay.SetOverlayAnchorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Height="30" Margin="2" FontSize="13" />
                                            </UniformGrid>
                                        </Border>

                                        <Button Content="{DynamicResource MoveToPrimary}" Command="{Binding Overlay.MoveToPrimaryMonitorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                                        <Button Content="{DynamicResource MoveToGameMonitor}" Command="{Binding Overlay.MoveToCaptureWindowMonitorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                                        <Button Content="{DynamicResource CenterOnCurrent}" Command="{Binding Overlay.CenterOnCurrentMonitorCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,6" HorizontalAlignment="Stretch" />
                                        <Button Content="{DynamicResource ResetPositionLabel}" Command="{Binding Overlay.ResetOverlayPositionCommand}" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{DynamicResource CardStyle}" Padding="14" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource OverlayAppearance}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                        <CheckBox Content="{DynamicResource OverlayActive}" IsChecked="{Binding Overlay.IsEnabled}" Margin="0,10,0,6" />
                                        <CheckBox Content="{DynamicResource ReplacementMaskActive}" IsChecked="{Binding Overlay.ReplacementMaskEnabled}" Margin="0,0,0,6" />
                                        <CheckBox Content="{DynamicResource ManualReplacementRegion}" IsChecked="{Binding Overlay.UseManualReplacementRegion}" Margin="0,0,0,6" />
                                        <CheckBox Content="{DynamicResource ShowPendingMask}" IsChecked="{Binding Overlay.ShowMaskWhileTranslationPending}" Margin="0,0,0,10" />

                                        <TextBlock Text="{DynamicResource FontFamilyLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,2" />
                                        <ComboBox SelectedValue="{Binding Overlay.FontFamily}" SelectedValuePath="Content" Margin="0,0,0,4">
                                            <ComboBoxItem Content="Segoe UI" />
                                            <ComboBoxItem Content="Arial" />
                                            <ComboBoxItem Content="Verdana" />
                                            <ComboBoxItem Content="Tahoma" />
                                            <ComboBoxItem Content="Calibri" />
                                            <ComboBoxItem Content="Consolas" />
                                            <ComboBoxItem Content="Times New Roman" />
                                        </ComboBox>

                                        <TextBlock Text="{DynamicResource TextSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,2" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Overlay.FontSize, StringFormat={}{0:F0} pt}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Value="{Binding Overlay.FontSize}" Minimum="12" Maximum="72" TickFrequency="2" IsSnapToTickEnabled="True" />
                                        </DockPanel>

                                        <TextBlock Text="{DynamicResource BackgroundOpacityLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,2" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Overlay.BackgroundOpacity, StringFormat={}{0:P0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Value="{Binding Overlay.BackgroundOpacity}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" />
                                        </DockPanel>

                                        <TextBlock Text="{DynamicResource TextColor}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,2" />
                                        <ComboBox SelectedValue="{Binding Overlay.TextColor}" SelectedValuePath="Tag">
                                            <ComboBoxItem Content="{DynamicResource ColorWhite}" Tag="#FFFFFF" />
                                            <ComboBoxItem Content="{DynamicResource ColorYellow}" Tag="#FFFF00" />
                                            <ComboBoxItem Content="{DynamicResource ColorCyan}" Tag="#00FFFF" />
                                            <ComboBoxItem Content="{DynamicResource ColorGreen}" Tag="#00FF88" />
                                            <ComboBoxItem Content="{DynamicResource ColorOrange}" Tag="#FF8C00" />
                                            <ComboBoxItem Content="{DynamicResource ColorPink}" Tag="#FF69B4" />
                                        </ComboBox>
                                        <TextBlock Text="{DynamicResource OverlayPreviewHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,10" />

                                        <TextBlock Text="{DynamicResource SubtitleAdvancedTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,6" />
                                        <CheckBox Content="{DynamicResource ReplacementAutoFit}" IsChecked="{Binding Overlay.ReplacementAutoFitText}" Margin="0,0,0,8" />
                                        <TextBlock Text="{DynamicResource ReplacementMaxLinesLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2" />
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Overlay.ReplacementMaxLines}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Width="30" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Value="{Binding Overlay.ReplacementMaxLines}" Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </DockPanel>
                                        <TextBlock Text="{DynamicResource ReplacementMinFontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,2" />
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Overlay.ReplacementMinFontSize, StringFormat={}{0:F0} pt}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Width="44" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Value="{Binding Overlay.ReplacementMinFontSize}" Minimum="8" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True" />
                                        </DockPanel>

                                        <Button Content="{DynamicResource ReplacementMaskPreview}" Command="{Binding Overlay.PreviewReplacementMaskCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                                        <Button Content="{DynamicResource SaveSettings}" Command="{Binding Overlay.SaveSettingsCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type user:ModelManagerPageViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16" LastChildFill="False">
                    <TextBlock Text="{DynamicResource NavModels}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" DockPanel.Dock="Left" />
                    <Button Content="{DynamicResource Refresh}" Command="{Binding ModelManager.RefreshCommand}" Style="{DynamicResource PrimaryButtonStyle}" DockPanel.Dock="Right" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Previously just a two-column status table: DisplayName +
                             StatusText, with no way to actually pick a model — the
                             view model already had Install/Verify/Remove/Use commands
                             and an IsActiveModel flag, none of it reachable from here.
                             This is how the trained "OPUS-MT FT (Fine-Tuned)" adapter
                             (or any other catalog model) actually gets activated.
                             Stacked full-width (rather than side-by-side with Ollama)
                             so the four action buttons have room and don't clip. -->
                        <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock Text="Yerel Modeller" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <DataGrid ItemsSource="{Binding ModelManager.MachineModels}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column"
                                          RowHeight="52">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Model" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center" Margin="0,4">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text=" ●" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"
                                                                 Visibility="{Binding IsActiveModel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Notes}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding StatusText}" Width="140" />
                                        <DataGridTemplateColumn Header="" Width="330">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <WrapPanel VerticalAlignment="Center">
                                                        <Button Content="Kullan" Command="{Binding UseCommand}"
                                                                Style="{DynamicResource PrimaryButtonStyle}" Padding="10,0" MinWidth="60" Height="28" FontSize="11" Margin="0,2,4,2" />
                                                        <Button Content="Kur" Command="{Binding InstallCommand}"
                                                                Style="{DynamicResource SecondaryButtonStyle}" Padding="10,0" MinWidth="50" Height="28" FontSize="11" Margin="0,2,4,2" />
