                                <Button Grid.Column="0" Content="{DynamicResource Accept}" Command="{Binding AcceptCommand}" Style="{DynamicResource PrimaryButtonStyle}" />
                                <Button Grid.Column="2" Content="{DynamicResource Reject}" Command="{Binding RejectCommand}" Style="{DynamicResource DangerButtonStyle}" />
