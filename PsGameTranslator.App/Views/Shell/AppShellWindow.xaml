                    <Border Grid.Column="0" Style="{DynamicResource CardStyle}">
                        <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}" IsReadOnly="False">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource ColSelect}" Binding="{Binding IsSelected}" Width="50" />
                                <DataGridTextColumn Header="{DynamicResource Source}" Binding="{Binding SourceText}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource ColTranslation}" Binding="{Binding FinalTranslation}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource ColStatus}" Binding="{Binding Status}" Width="120" IsReadOnly="True" />
                                <DataGridTextColumn Header="{DynamicResource ColTime}" Binding="{Binding Timestamp}" Width="90" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="2" Style="{DynamicResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource SelectedRecord}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedRecord.SourceText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <TextBlock Text="{Binding SelectedRecord.FinalTranslation}" Foreground="{DynamicResource AccentBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" />

