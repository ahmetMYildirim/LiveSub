                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TrainingViewModel}">
            <Grid>
                <!-- ── Locked state: PIN gate ─────────────────────────────────────── -->
                <Border Style="{DynamicResource CardStyle}" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding IsUnlocked, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="&#128274;" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="{DynamicResource TrainingLocked}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource EnterPinToContinue}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,18" />
                        <PasswordBox x:Name="TrainingPinBox" PasswordChanged="TrainingPinBox_PasswordChanged" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding PinErrorText}" Foreground="{DynamicResource DangerBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <Button Content="{DynamicResource Unlock}" Command="{Binding UnlockCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- ── Unlocked state: training console ──────────────────────────── -->
                <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" MinHeight="560" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource TrainingTitle}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28" FontWeight="Bold" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: dataset + hyperparameters + actions -->
                        <StackPanel Grid.Column="0">
                            <!-- Item 12: Dataset istatistik paneli -->
                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{DynamicResource ReviewedRecords}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" />
                                        <Button Content="{DynamicResource Refresh}" Command="{Binding RefreshReviewedStatsCommand}" Style="{DynamicResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="10,4" />
                                    </DockPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Column="0" Grid.Row="0">
                                            <TextBlock Text="{Binding AcceptedCount}" Foreground="{DynamicResource SuccessBrush}" FontSize="22" FontWeight="Bold" />
                                            <TextBlock Text="{DynamicResource AcceptedLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="0">
                                            <TextBlock Text="{Binding EditedCount}" Foreground="{DynamicResource AccentBrush}" FontSize="22" FontWeight="Bold" />
                                            <TextBlock Text="{DynamicResource EditedLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="0" Grid.Row="2">
                                            <TextBlock Text="{Binding RejectedCount}" Foreground="{DynamicResource DangerBrush}" FontSize="22" FontWeight="Bold" />
                                            <TextBlock Text="{DynamicResource RejectedLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Grid.Row="2">
                                            <TextBlock Text="{Binding ExportableCount}" Foreground="{DynamicResource WarningBrush}" FontSize="22" FontWeight="Bold" />
                                            <TextBlock Text="{DynamicResource ExportableLabel}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{DynamicResource Dataset}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" />
                                        <Button Content="{DynamicResource Refresh}" Command="{Binding RefreshDatasetCountsCommand}" Style="{DynamicResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="10,4" />
                                    </DockPanel>
                                    <CheckBox Content="{Binding DeepLCount, StringFormat='DeepL ({0} cift)'}" IsChecked="{Binding UseDeepLDataset}" Margin="0,14,0,10" />
                                    <CheckBox Content="{Binding GoogleCount, StringFormat='Google Translate ({0} cift)'}" IsChecked="{Binding UseGoogleDataset}" Margin="0,0,0,10" />
                                    <TextBlock Text="{Binding TotalDatasetCount, StringFormat='Toplam secili: {0} cift'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{DynamicResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource TrainingParameters}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />

                                    <TextBlock Text="Epoch" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBox Text="{Binding Epochs, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                                    <TextBlock Text="Batch Size" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                                    <TextBlock Text="Learning Rate" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBox Text="{Binding LearningRate, UpdateSourceTrigger=PropertyChanged, StringFormat=0.######}" Margin="0,4,0,10" />

                                    <TextBlock Text="Max Sequence Length" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBox Text="{Binding MaxLength, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                                    <TextBlock Text="{DynamicResource ValidationSplit}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <TextBox Text="{Binding ValSplitPercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10" />

                                    <TextBlock Text="LoRA r / alpha" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding LoraR, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Text="{Binding LoraAlpha, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Content="{DynamicResource CalculateVram}" Command="{Binding EstimateVramCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,0,10" />
                            <Button Content="{DynamicResource StartTraining}" Command="{Binding StartTrainingCommand}" Style="{DynamicResource PrimaryButtonStyle}" Margin="0,0,0,10" />
                            <Button Content="{DynamicResource Stop}" Command="{Binding StopTrainingCommand}" Style="{DynamicResource DangerButtonStyle}" Margin="0,0,0,16"/>
                            <!-- Item 6: Tek tikla filtrelenmis yeniden egit -->
                            <Button Content="{Binding ExportableCount, StringFormat='İncelenen Kayıtlardan Eğit ({0} cift)'}"
                                    Command="{Binding QuickRetrainCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>

                        <!-- Right: live status, metrics, VRAM/RAM, log console, model comparison -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="*" MinHeight="220" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{DynamicResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentEpoch, StringFormat='Epoch {0:F2}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,2,0,0">
                                        <Run Text=" / " /><Run Text="{Binding TotalEpochs, Mode=OneWay}" /><Run Text="{DynamicResource TotalSuffix}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding CurrentStep, StringFormat='Adim: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{DynamicResource CardStyle}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource LossLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding TrainLoss, StringFormat='{}{0:F4}'}" Foreground="{DynamicResource WarningBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding EvalLoss, StringFormat='dogrulama: {0:F4}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{DynamicResource CardStyle}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="BLEU" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding BleuScore, StringFormat='{}{0:F1}'}" Foreground="{DynamicResource SuccessBrush}" FontSize="18" FontWeight="Bold" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{DynamicResource CardStyle}" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="Precision / Recall / F1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0">
                                            <Run Text="{Binding Precision, Mode=OneWay, StringFormat='{}{0:F2}'}" /><Run Text=" / " />
                                            <Run Text="{Binding Recall, Mode=OneWay, StringFormat='{}{0:F2}'}" /><Run Text=" / " />
                                            <Run Text="{Binding F1Score, Mode=OneWay, StringFormat='{}{0:F2}'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Test seti (Google Translate - held-out) -->
                            <Border Grid.Row="3" Margin="0,8,0,0" Style="{DynamicResource CardStyle}" Padding="14"
                                    Visibility="{Binding TestBleuScore, Converter={StaticResource NullToCollapsedConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11">
                                            <Run Text="{DynamicResource TestSet}" FontWeight="Bold" /><Run Text=" (Google Translate · " /><Run Text="{Binding TestPairCount, Mode=OneWay}" /><Run Text="{DynamicResource PairsSuffix}" />
                                        </TextBlock>
                                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" Text="{DynamicResource NeverSeenInTraining}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="BLEU " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TestBleuScore, StringFormat='{}{0:F1}'}" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="P / R / F1" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0">
                                            <Run Text="{Binding TestPrecision, Mode=OneWay, StringFormat='{}{0:F2}'}" /><Run Text=" / " />
                                            <Run Text="{Binding TestRecall, Mode=OneWay, StringFormat='{}{0:F2}'}" /><Run Text=" / " />
                                            <Run Text="{Binding TestF1Score, Mode=OneWay, StringFormat='{}{0:F2}'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="5" Style="{DynamicResource CardStyle}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="16,14,16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{DynamicResource VramLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0">
                                                <Run Text="~" /><Run Text="{Binding EstimatedVramMb, Mode=OneWay}" /><Run Text="{DynamicResource MbEstimated}" />
                                            </TextBlock>
                                            <TextBlock FontSize="13" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding CurrentVramAllocatedMb, Mode=OneWay}" /><Run Text=" / " />
                                                <Run Text="{Binding TotalVramMb, Mode=OneWay}" /><Run Text="{DynamicResource MbInUse}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="RAM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0">
                                                <Run Text="{Binding CurrentRamMb, Mode=OneWay}" /><Run Text=" / " />
                                                <Run Text="{Binding TotalRamMb, Mode=OneWay}" /><Run Text=" MB" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Row="1" Background="#070A11" Margin="16,0,16,16" CornerRadius="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                                            <ItemsControl ItemsSource="{Binding LogLines}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" Foreground="#B7C2D8" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Item 15: Model karşılaştırma aracı -->
                            <Border Grid.Row="7" Style="{DynamicResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ModelComparison}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="Bold" Margin="0,0,0,14" />
                                    <TextBlock Text="{DynamicResource SourceText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                                    <DockPanel Margin="0,4,0,0">
                                        <Button DockPanel.Dock="Right" Content="{DynamicResource Compare}" Command="{Binding RunComparisonCommand}"
                                                Style="{DynamicResource PrimaryButtonStyle}" Padding="14,6" Margin="10,0,0,0" />
                                        <TextBox Text="{Binding CompareSourceText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="False" TextWrapping="Wrap" MinHeight="36" />
                                    </DockPanel>
                                    <Border Background="#070A11" CornerRadius="8" Margin="0,10,0,0" MinHeight="80"
                                            Visibility="{Binding HasComparisonResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12" MaxHeight="220">
                                            <TextBlock Text="{Binding ComparisonResultsText}" Foreground="#B7C2D8"
                                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource AppBgBrush}" BorderBrush="#1F2937" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="44" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" Style="{DynamicResource PanelStyle}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{DynamicResource LogoFrameStyle}">
                                <Image Source="pack://application:,,,/Assets/logo_icon_transparent.png"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="LiveSub"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource AccentGradientBrush}"
                                            CornerRadius="6"
                                            Padding="7,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource ProBadge}"
                                                   Foreground="White"
                                                   FontSize="10"
                                                   FontWeight="Bold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource AppSubtitle}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding UserNavigationItems}"
                             SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                             Style="{DynamicResource NavListBoxStyle}"
                             ItemContainerStyle="{DynamicResource NavListBoxItemStyle}"
                             Margin="0,30,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="{Binding AccentHex}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" Visibility="{Binding DataContext.SidebarTextVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- Debug-only: absent from the released EXE (see
                         AppShellViewModel.IsDeveloperModeAvailable). -->
                    <Border Grid.Row="2" Style="{DynamicResource CardStyle}" Margin="0,16,0,14" Padding="16"
                            Visibility="{Binding DeveloperModeVisibility}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource DeveloperMode}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Ctrl + Shift + D" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,12" />
                            <Button Content="{Binding DeveloperModeButtonText}"
                                    Command="{Binding ToggleDeveloperModeCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Style="{DynamicResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Theme}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                            <ComboBox SelectedIndex="{Binding ThemeIndex}" Margin="0,7,0,0">
                                <ComboBoxItem Content="{DynamicResource Dark}" />
                                <ComboBoxItem Content="{DynamicResource Light}" />
                            </ComboBox>
                            <TextBlock Text="{DynamicResource Language}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,0" />
                            <ComboBox SelectedIndex="{Binding LanguageIndex}" Margin="0,7,0,0">
                                <ComboBoxItem Content="{DynamicResource Turkish}" />
                                <ComboBoxItem Content="{DynamicResource English}" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="0" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource PanelStyle}" Padding="22,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource SuccessBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Home.RunStatus}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Home.Monitoring.LastCaptureTimeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Margin="28,0,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource SelectGame}" Command="{Binding SelectGameCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                        <Button Grid.Column="3" Content="{DynamicResource Stop}" Command="{Binding Home.StopCommand}" Style="{DynamicResource DangerButtonStyle}" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                            <Button Content="-" Click="MinimizeButton_Click" Style="{DynamicResource IconButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="□" Click="MaximizeButton_Click" Style="{DynamicResource IconButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="X" Click="CloseButton_Click" Style="{DynamicResource IconButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" />
            </Grid>

            <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource PanelStyle}" Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Home.SystemResources.CpuUsageText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Home.SystemResources.RamUsageText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="13">
                        <Run Text="{DynamicResource RegionLabel}" /><Run Text=" " /><Run Text="{Binding Home.Overlay.CurrentOverlayRectText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="3" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" FontSize="13">
                        <Run Text="{DynamicResource Latency}" /><Run Text=": " /><Run Text="{Binding Home.AvgLatency, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="4" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" FontSize="13">
                        <Run Text="FPS " /><Run Text="{Binding Home.Fps, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Grid.Column="5" Text="{DynamicResource Version}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" FontSize="13" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
