<UserControl x:Class="PsGameTranslator.App.Views.User.SettingsPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:PsGameTranslator.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{DynamicResource CardStyle}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource NavSettings}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource SettingsSubtitle}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource AdvancedSettings}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <CheckBox Style="{DynamicResource ToggleSwitchStyle}" IsChecked="{Binding IsAdvancedMode}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="{DynamicResource ImportSettings}" Command="{Binding ImportSettingsCommand}" Style="{DynamicResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource ExportSettings}" Command="{Binding ExportSettingsCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                    <Setter Property="Padding" Value="14,8" />
                    <Setter Property="Margin" Value="0,0,8,0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource SecondaryButtonBrush}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="{DynamicResource TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{DynamicResource CardStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Appearance}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource ThemeLiveHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="{DynamicResource Dark}" GroupName="Theme" IsChecked="{Binding IsDarkThemeSelected, Mode=OneWay}" Command="{Binding SelectDarkThemeCommand}" Margin="0,0,24,0" />
                                    <RadioButton Content="{DynamicResource Light}" GroupName="Theme" IsChecked="{Binding IsLightThemeSelected, Mode=OneWay}" Command="{Binding SelectLightThemeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource PresetProfile}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource PresetProfileHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,12" />
                                <ComboBox SelectedIndex="{Binding SelectedPresetIndex}">
                                    <ComboBoxItem Content="{DynamicResource PresetFast}" />
                                    <ComboBoxItem Content="{DynamicResource PresetBalanced}" />
                                    <ComboBoxItem Content="{DynamicResource PresetQuality}" />
                                </ComboBox>
                                <Button Content="{DynamicResource ApplyPreset}" Command="{Binding ApplyPresetCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding OperationStatus}" Foreground="{DynamicResource SuccessBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource TabTranslationApi}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{DynamicResource CardStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LanguageAndProvider}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource SourceLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4" />
                                <TextBox Text="{Binding Translation.SourceLanguage, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{DynamicResource TargetLanguage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4" />
                                <TextBox Text="{Binding Translation.TargetLanguage, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{DynamicResource TranslationProfile}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4" />
                                <ComboBox SelectedIndex="{Binding Translation.TranslationProfileIndex}">
                                    <ComboBoxItem Content="{DynamicResource ProfileBalanced}"/><ComboBoxItem Content="{DynamicResource ProfileFast}"/><ComboBoxItem Content="{DynamicResource ProfileQuality}"/><ComboBoxItem Content="{DynamicResource ProfileLocalFast}"/><ComboBoxItem Content="{DynamicResource ProfileCustom}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource CloudApiKeys}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource ApiKeysHint}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,5,0,12" TextWrapping="Wrap" />
                                <TextBlock Text="{DynamicResource GoogleTranslateOptional}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:SecureApiKeyBox Value="{Binding Translation.GoogleTranslateApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8" />
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="DeepL" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:SecureApiKeyBox Value="{Binding Translation.DeepLApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8" />
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Gemini" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:SecureApiKeyBox Value="{Binding Translation.GeminiApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8" />
                                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,8" />
                                <TextBlock Text="Groq" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <controls:SecureApiKeyBox Value="{Binding Translation.GroqApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,8" />
                                <Button Content="{DynamicResource TestProviders}" Command="{Binding Translation.CheckAllProvidersCommand}" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource TabOcrPerformance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{DynamicResource CardStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Performance}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource CaptureIntervalMs}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4" />
                                <TextBox Text="{Binding Monitoring.CaptureIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="{DynamicResource MinOcrIntervalMs}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4" />
                                <TextBox Text="{Binding Monitoring.MinOcrIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="{DynamicResource FastOcrMode}" IsChecked="{Binding Monitoring.EnableFastOcrMode}" Margin="0,12,0,5" />
                                <CheckBox Content="{DynamicResource PauseWhenBackground}" IsChecked="{Binding Monitoring.PauseWhenWindowNotActive}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,14" Visibility="{Binding AdvancedVisibility}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource AdvancedOcr}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                <CheckBox Content="{DynamicResource EnablePreprocessing}" IsChecked="{Binding Monitoring.EnableOcrPreprocessing}" Margin="0,12,0,5" />
                                <CheckBox Content="{DynamicResource ConvertGrayscale}" IsChecked="{Binding Monitoring.ConvertToGrayscale}" Margin="0,0,0,5" />
                                <CheckBox Content="{DynamicResource IncreaseContrast}" IsChecked="{Binding Monitoring.IncreaseContrast}" Margin="0,0,0,5" />
                                <CheckBox Content="{DynamicResource SharpenImage}" IsChecked="{Binding Monitoring.SharpenImage}" Margin="0,0,0,10" />
                                <TextBlock Text="{DynamicResource OcrTimeoutMs}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding Ocr.OcrTimeoutMs, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Overlay">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,12,0,0">
                        <Border Style="{DynamicResource CardStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource OverlayAppearance}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                <CheckBox Content="{DynamicResource OverlayEnabled}" IsChecked="{Binding Overlay.IsEnabled}" Margin="0,12,0,8" />
                                <TextBlock Text="{DynamicResource FontSizeLabel}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Slider Value="{Binding Overlay.FontSize}" Minimum="12" Maximum="72" TickFrequency="2" />
                                <TextBlock Text="{DynamicResource BackgroundOpacity}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" />
                                <Slider Value="{Binding Overlay.BackgroundOpacity}" Minimum="0" Maximum="1" TickFrequency="0.05" />
                                <Button Content="{DynamicResource TestOverlayButton}" Command="{Binding Overlay.TestReplacementOverlayCommand}" Style="{DynamicResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{DynamicResource CardStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,14" Visibility="{Binding AdvancedVisibility}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource MonitorAndPosition}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="Bold" />
                                <TextBlock Text="{DynamicResource TargetMonitor}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,4" />
                                <ComboBox SelectedIndex="{Binding Overlay.OverlayTargetMonitorModeIndex}">
                                    <ComboBoxItem Content="{DynamicResource MonitorPrimary}"/><ComboBoxItem Content="{DynamicResource MonitorSameAsGame}"/><ComboBoxItem Content="{DynamicResource MonitorManual}"/>
                                </ComboBox>
                                <Button Content="{DynamicResource CenterOnCurrentMonitor}" Command="{Binding Overlay.CenterOnCurrentMonitorCommand}" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                                <Button Content="{DynamicResource ResetPosition}" Command="{Binding Overlay.ResetOverlayPositionCommand}" Style="{DynamicResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
