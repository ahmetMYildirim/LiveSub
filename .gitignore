# Python virtual environments (all variants, e.g. .venv, .venv-game-onnx-py312)
.venv*/
.vs/
**/bin/
**/obj/
**/logs/
**/debug/
__pycache__/
*.user
work/
tmp-logo-nodeps/
.dotnet-cli/
.localappdata/
.nuget-packages/
artifacts/
tmp/

# Runtime user config holds personal API keys — never commit it. It normally
# lives under **/bin/ (already ignored) but guard the pattern explicitly too.
**/config/user_settings.json
publish/
*.zip
